#!/bin/bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$SCRIPT_DIR/common.sh"

APPDIR="${TRIM_APPDEST:?缺少 TRIM_APPDEST}"
VARDIR="${TRIM_PKGVAR:?缺少 TRIM_PKGVAR}"
apply_wizard_settings "$APPDIR" "$VARDIR"

if [ "$(id -u)" = "0" ] && [ -n "${TRIM_UID:-}" ]; then
  chown -R "${TRIM_UID}:${TRIM_GID:-$TRIM_UID}" "$VARDIR" 2>/dev/null || true
fi

printf "设置已保存。应用会在下次启动或下次同步时生效。\n"