#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=common.sh
. "$SCRIPT_DIR/common.sh"

MUSIC_DIR="${wizard_music_dir:-}"
[ -n "$MUSIC_DIR" ] || MUSIC_DIR="$(read_env WY_MUSIC_DIR || true)"
MUSIC_DIR="${MUSIC_DIR:-/vol1/1000/Music}"

INTERVAL="${wizard_interval:-}"
[ -n "$INTERVAL" ] || INTERVAL="$(read_env WY_MUSIC_INTERVAL || true)"
INTERVAL="${INTERVAL:-3600}"

TIMEZONE="${wizard_timezone:-}"
[ -n "$TIMEZONE" ] || TIMEZONE="$(read_env TZ || true)"
TIMEZONE="${TIMEZONE:-Asia/Shanghai}"

DRY_RUN="${wizard_dry_run:-}"
[ -n "$DRY_RUN" ] || DRY_RUN="$(read_env WY_MUSIC_DRY_RUN || true)"
DRY_RUN="${DRY_RUN:-false}"

PUID_VALUE="$(read_env PUID || true)"
PUID_VALUE="${PUID_VALUE:-1000}"
PGID_VALUE="$(read_env PGID || true)"
PGID_VALUE="${PGID_VALUE:-1000}"
VERSION="${TRIM_APPVER:-$(read_env WY_VERSION || true)}"
VERSION="${VERSION:-0.1.0}"

write_env_file "$MUSIC_DIR" "$INTERVAL" "$TIMEZONE" "$DRY_RUN" "$PUID_VALUE" "$PGID_VALUE" "$VERSION"
echo "wy-music-cloud 配置已更新: $ENV_FILE"
