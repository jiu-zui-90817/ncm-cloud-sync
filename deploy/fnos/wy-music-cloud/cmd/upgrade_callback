#!/bin/bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$SCRIPT_DIR/common.sh"

APPDIR="${TRIM_APPDEST:?缺少 TRIM_APPDEST}"
VARDIR="${TRIM_PKGVAR:?缺少 TRIM_PKGVAR}"
mkdir -p "$VARDIR/data"
chmod 700 "$VARDIR/data" 2>/dev/null || true

# 升级不覆盖用户设置；只有设置文件丢失时才用向导值重建。
if [ ! -f "$VARDIR/settings.json" ]; then
  apply_wizard_settings "$APPDIR" "$VARDIR"
else
  write_login_hint "$VARDIR" "$APPDIR"
fi
rm -f "$APPDIR/app.sock" "$VARDIR/app.pid"

if [ "$(id -u)" = "0" ] && [ -n "${TRIM_UID:-}" ]; then
  chown -R "${TRIM_UID}:${TRIM_GID:-$TRIM_UID}" "$VARDIR" 2>/dev/null || true
fi

printf "升级完成，原有登录状态和同步记录已保留。\n"